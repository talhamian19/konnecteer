generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── AUTH ──────────────────────────────────────────────────────────────────

model User {
  id               String    @id @default(cuid())
  email            String    @unique
  emailVerified    DateTime?
  name             String?
  username         String?   @unique
  image            String?
  bio              String?
  dob              DateTime?
  location         String?
  latitude         Float?
  longitude        Float?
  passwordHash     String?
  stripeCustomerId String?
  isVerified       Boolean   @default(false)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  accounts         Account[]
  sessions         Session[]
  hostedEvents     Event[]          @relation("EventHost")
  attendances      EventAttendance[]
  tickets          Ticket[]
  tagAlongPosts    TagAlongPost[]   @relation("TagAlongCreator")
  tagAlongRequests TagAlongRequest[]
  talkAlongPosts   TalkAlongPost[]  @relation("TalkAlongCreator")
  talkAlongRequests TalkAlongRequest[]
  messagesSent     ChatMessage[]    @relation("MessageSender")
  chatMembers      ChatMember[]
  notifications    Notification[]
  reports          Report[]         @relation("Reporter")
  payments         Payment[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ─── EVENTS ────────────────────────────────────────────────────────────────

model Event {
  id            String          @id @default(cuid())
  title         String
  description   String          @db.Text
  hostId        String
  host          User            @relation("EventHost", fields: [hostId], references: [id])
  location      String
  address       String?
  latitude      Float?
  longitude     Float?
  startTime     DateTime
  endTime       DateTime?
  category      EventCategory   @default(OTHER)
  price         Float           @default(0)
  isFree        Boolean         @default(true)
  maxAttendees  Int?
  coverImage    String?
  status        EventStatus     @default(ACTIVE)
  viewCount     Int             @default(0)
  isBoosted     Boolean         @default(false)
  boostExpiresAt DateTime?
  rankScore     Float           @default(0)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  media         EventMedia[]
  attendances   EventAttendance[]
  tickets       Ticket[]
  chat          Chat?
  hashtags      EventHashtag[]
  boosts        BoostedEvent[]
  reports       Report[]

  @@map("events")
}

enum EventCategory {
  SPORTS
  MUSIC
  FOOD
  HIKE
  PARTY
  TRAVEL
  TECH
  ART
  FITNESS
  NETWORKING
  OTHER
}

enum EventStatus {
  ACTIVE
  CANCELLED
  COMPLETED
  DRAFT
}

model EventMedia {
  id        String   @id @default(cuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  url       String
  type      String   @default("image")
  order     Int      @default(0)
  createdAt DateTime @default(now())

  @@map("event_media")
}

model EventAttendance {
  id        String   @id @default(cuid())
  eventId   String
  userId    String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([eventId, userId])
  @@map("event_attendances")
}

// ─── TICKETS ───────────────────────────────────────────────────────────────

model Ticket {
  id          String       @id @default(cuid())
  eventId     String
  userId      String
  event       Event        @relation(fields: [eventId], references: [id])
  user        User         @relation(fields: [userId], references: [id])
  paymentId   String?
  payment     Payment?     @relation(fields: [paymentId], references: [id])
  qrCode      String       @unique @default(cuid())
  status      TicketStatus @default(VALID)
  scannedAt   DateTime?
  scannedBy   String?
  createdAt   DateTime     @default(now())

  @@map("tickets")
}

enum TicketStatus {
  VALID
  USED
  CANCELLED
  REFUNDED
}

model Payment {
  id                String        @id @default(cuid())
  userId            String
  user              User          @relation(fields: [userId], references: [id])
  stripePaymentId   String?       @unique
  stripeSessionId   String?       @unique
  amount            Float
  currency          String        @default("usd")
  status            PaymentStatus @default(PENDING)
  tickets           Ticket[]
  createdAt         DateTime      @default(now())

  @@map("payments")
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

// ─── BOOSTED EVENTS ────────────────────────────────────────────────────────

model BoostedEvent {
  id        String   @id @default(cuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id])
  amount    Float
  startedAt DateTime @default(now())
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("boosted_events")
}

// ─── TAG ALONG ─────────────────────────────────────────────────────────────

model TagAlongPost {
  id           String           @id @default(cuid())
  creatorId    String
  creator      User             @relation("TagAlongCreator", fields: [creatorId], references: [id])
  title        String
  description  String?          @db.Text
  location     String
  latitude     Float?
  longitude    Float?
  activity     String
  scheduledAt  DateTime
  maxPeople    Int?
  vibeTags     String[]         @default([])
  category     EventCategory    @default(OTHER)
  viewCount    Int              @default(0)
  status       PostStatus       @default(ACTIVE)
  rankScore    Float            @default(0)
  chat         Chat?
  requests     TagAlongRequest[]
  hashtags     TagAlongHashtag[]
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@map("tag_along_posts")
}

model TagAlongRequest {
  id         String        @id @default(cuid())
  postId     String
  userId     String
  post       TagAlongPost  @relation(fields: [postId], references: [id], onDelete: Cascade)
  user       User          @relation(fields: [userId], references: [id])
  status     RequestStatus @default(PENDING)
  createdAt  DateTime      @default(now())

  @@unique([postId, userId])
  @@map("tag_along_requests")
}

// ─── TALK ALONG ────────────────────────────────────────────────────────────

model TalkAlongPost {
  id          String             @id @default(cuid())
  creatorId   String
  creator     User               @relation("TalkAlongCreator", fields: [creatorId], references: [id])
  title       String
  description String?            @db.Text
  topic       String
  viewCount   Int                @default(0)
  memberCount Int                @default(1)
  status      PostStatus         @default(ACTIVE)
  rankScore   Float              @default(0)
  chat        Chat?
  requests    TalkAlongRequest[]
  hashtags    TalkAlongHashtag[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@map("talk_along_posts")
}

model TalkAlongRequest {
  id        String         @id @default(cuid())
  postId    String
  userId    String
  post      TalkAlongPost  @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User           @relation(fields: [userId], references: [id])
  status    RequestStatus  @default(PENDING)
  createdAt DateTime       @default(now())

  @@unique([postId, userId])
  @@map("talk_along_requests")
}

enum PostStatus {
  ACTIVE
  CLOSED
  CANCELLED
}

enum RequestStatus {
  PENDING
  ACCEPTED
  DECLINED
}

// ─── CHATS ─────────────────────────────────────────────────────────────────

model Chat {
  id             String      @id @default(cuid())
  type           ChatType
  eventId        String?     @unique
  tagAlongPostId String?     @unique
  talkAlongPostId String?    @unique
  event          Event?      @relation(fields: [eventId], references: [id])
  tagAlong       TagAlongPost? @relation(fields: [tagAlongPostId], references: [id])
  talkAlong      TalkAlongPost? @relation(fields: [talkAlongPostId], references: [id])
  members        ChatMember[]
  messages       ChatMessage[]
  createdAt      DateTime    @default(now())

  @@map("chats")
}

enum ChatType {
  PRIVATE
  EVENT
  TAG_ALONG
  TALK_ALONG
}

model ChatMember {
  id       String   @id @default(cuid())
  chatId   String
  userId   String
  chat     Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id])
  isAdmin  Boolean  @default(false)
  joinedAt DateTime @default(now())

  @@unique([chatId, userId])
  @@map("chat_members")
}

model ChatMessage {
  id          String   @id @default(cuid())
  chatId      String
  senderId    String
  chat        Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)
  sender      User     @relation("MessageSender", fields: [senderId], references: [id])
  content     String   @db.Text
  mediaUrl    String?
  isPinned    Boolean  @default(false)
  isDeleted   Boolean  @default(false)
  replyToId   String?
  replyTo     ChatMessage? @relation("Replies", fields: [replyToId], references: [id])
  replies     ChatMessage[] @relation("Replies")
  createdAt   DateTime @default(now())

  @@map("chat_messages")
}

// ─── HASHTAGS ──────────────────────────────────────────────────────────────

model Hashtag {
  id         String            @id @default(cuid())
  tag        String            @unique
  useCount   Int               @default(0)
  events     EventHashtag[]
  tagAlongs  TagAlongHashtag[]
  talkAlongs TalkAlongHashtag[]
  createdAt  DateTime          @default(now())

  @@map("hashtags")
}

model EventHashtag {
  eventId   String
  hashtagId String
  event     Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  hashtag   Hashtag @relation(fields: [hashtagId], references: [id])

  @@id([eventId, hashtagId])
  @@map("event_hashtags")
}

model TagAlongHashtag {
  postId    String
  hashtagId String
  post      TagAlongPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  hashtag   Hashtag      @relation(fields: [hashtagId], references: [id])

  @@id([postId, hashtagId])
  @@map("tag_along_hashtags")
}

model TalkAlongHashtag {
  postId    String
  hashtagId String
  post      TalkAlongPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  hashtag   Hashtag       @relation(fields: [hashtagId], references: [id])

  @@id([postId, hashtagId])
  @@map("talk_along_hashtags")
}

// ─── NOTIFICATIONS ─────────────────────────────────────────────────────────

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  message   String
  data      Json?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@map("notifications")
}

enum NotificationType {
  EVENT_REMINDER
  JOIN_REQUEST
  REQUEST_ACCEPTED
  REQUEST_DECLINED
  NEW_MESSAGE
  EVENT_CANCELLED
  TICKET_PURCHASED
  GENERAL
}

// ─── REPORTS ───────────────────────────────────────────────────────────────

model Report {
  id         String       @id @default(cuid())
  reporterId String
  reporter   User         @relation("Reporter", fields: [reporterId], references: [id])
  eventId    String?
  event      Event?       @relation(fields: [eventId], references: [id])
  reason     String
  status     ReportStatus @default(PENDING)
  createdAt  DateTime     @default(now())

  @@map("reports")
}

enum ReportStatus {
  PENDING
  REVIEWED
  RESOLVED
  DISMISSED
}
